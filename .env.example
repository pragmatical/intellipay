# Copy this file to .env. The .env file is ignored by Git.
# Use "local" for deterministic offline behavior or "live" for real Grok calls.
INTELLIPAY_REASONING_MODE=local
INTELLIPAY_DATABASE_PATH=.intellipay/intellipay.db

# xAI Grok configuration. XAI_API_KEY is required only in live mode.
XAI_API_KEY=
INTELLIPAY_XAI_MODEL=grok-4.6
INTELLIPAY_XAI_BASE_URL=https://api.x.ai/v1
INTELLIPAY_XAI_TIMEOUT_SECONDS=30