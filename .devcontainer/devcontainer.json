{
	"name": "Invoice Multi-Agent Development",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true
		},
		"ghcr.io/devcontainers/features/node:2.1.0": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
			"version": "latest",
			"dockerDashComposeVersion": "v2"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"containerEnv": {
		"PYTHONUNBUFFERED": "1",
		"PYTHONDONTWRITEBYTECODE": "1",
		"PIP_DISABLE_PIP_VERSION_CHECK": "1",
		"UV_LINK_MODE": "copy"
	},
	"mounts": [
		"source=intellipay-zsh-history,target=/commandhistory,type=volume"
	],
	"postCreateCommand": "sudo chown vscode:vscode /commandhistory && touch /commandhistory/.zsh_history && python -m pip install --user --upgrade uv",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"ms-toolsai.jupyter",
				"charliermarsh.ruff",
				"tamasfe.even-better-toml",
				"tomoki1207.pdf"
			],
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"python.testing.unittestEnabled": false,
				"editor.formatOnSave": true,
				"remote.extensionKind": {
					"tomoki1207.pdf": [
						"workspace"
					]
				},
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}
	},
	"remoteUser": "vscode"
}